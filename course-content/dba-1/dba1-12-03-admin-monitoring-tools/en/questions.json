        {
          "key": "c",
          "text": "none — disable statement statistics collection",
          "correct": true
        },
        {
          "key": "d",
          "text": "snapshot — save only one query per transaction",
          "correct": false
        }
      ],
      "explanation": "pg_stat_statements.track supports top, all, and none; the default is top.",
      "source": {
