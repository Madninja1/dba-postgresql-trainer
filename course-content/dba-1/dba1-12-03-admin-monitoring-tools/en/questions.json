    {
      "key": "dba1-admin-monitoring-tools-017",
      "type": "single_choice",
      "text": "Why do two queries that differ only in constant values usually end up in one pg_stat_statements entry?",
      "answers": [
        {
          "key": "a",
          "text": "pg_stat_statements groups queries with the same internal structure, normally replacing constants with parameters",
          "correct": true
        },
        {
          "key": "b",
          "text": "PostgreSQL stores only the last executed SQL text",
          "correct": false
        },
        {
          "key": "c",
          "text": "All queries from one user have the same queryid",
          "correct": false
        },
        {
          "key": "d",
          "text": "Constants are removed from source tables before execution",
          "correct": false
        }
      ],
      "explanation": "pg_stat_statements combines structurally equivalent queries using the internal queryid; constant values normally do not distinguish entries and are displayed as parameters such as $1.",
      "source": {
        "key": "dba1-12-pgss-normalization",
        "kind": "course_material",
        "module": "DBA1",
        "section": "pg_stat_statements",
        "locator": "Query normalization and queryid",
        "url": "https://postgrespro.ru/docs/postgresql/16/pgstatstatements"
      }
    },
    {
      "key": "dba1-admin-monitoring-tools-018",
      "type": "multiple_choice",
      "text": "Which pg_stat_statements.track values and meanings are correct? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "top — track top-level statements",
          "correct": true
        },
        {
          "key": "b",
          "text": "all — also track nested statements",
