    {
      "key": "dba1-admin-monitoring-016",
      "type": "multiple_choice",
      "text": "Which characteristics should be considered when reading PostgreSQL cumulative statistics? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "Statistics are transferred to shared memory not after every individual event",
          "correct": true
        },
        {
          "key": "b",
          "text": "Different consistency modes can be used when statistics are read within a transaction",
          "correct": true
        },
        {
          "key": "c",
          "text": "stats_fetch_consistency affects how the statistics snapshot is obtained",
          "correct": true
        },
        {
          "key": "d",
          "text": "All statistics values are always updated synchronously after every SQL row",
          "correct": false
        }
      ],
      "explanation": "The notes specifically show delayed cumulative-statistics updates and the none, cache, and snapshot modes for reading them.",
      "source": {
        "key": "dba1-12-cumulative-stats-016",
        "kind": "course_material",
        "module": "DBA1",
        "section": "Cumulative Statistics",
        "locator": "Statistics collection diagram and stats_fetch_consistency",
        "url": null
      }
    },
    {
      "key": "dba1-admin-monitoring-017",
      "type": "multiple_choice",
      "text": "Which mappings between PostgreSQL statistics-collection parameters and their purposes are correct? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "track_activities — tracking current commands of server processes",
          "correct": true
        },
        {
          "key": "b",
          "text": "track_counts — cumulative statistics for accesses to tables and indexes",
          "correct": true
        },
        {
          "key": "c",
          "text": "track_functions — statistics for use of user-defined functions",
          "correct": true
        },
        {
          "key": "d",
          "text": "track_io_timing — measuring block I/O time",
          "correct": true
        },
        {
          "key": "e",
          "text": "track_counts — enabling file log rotation",
          "correct": false
        }
      ],
      "explanation": "The cumulative-statistics system is controlled by track_* parameters. track_activities covers current commands, track_counts table/index accesses, track_functions user functions, and track_io_timing block I/O timing.",
      "source": {
        "key": "dba1-12-statistics-config",
        "kind": "course_material",
        "module": "DBA1",
        "section": "Statistics Collection",
        "locator": "Slide 5 and PostgreSQL 16 section 28.2.1",
        "url": "https://postgrespro.ru/docs/postgresql/16/monitoring-stats"
      }
    },
