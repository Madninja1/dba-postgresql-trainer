    {
      "key": "dba1-admin-monitoring-019",
      "type": "single_choice",
      "text": "What is pg_stat_clear_snapshot() used for when working with cumulative statistics?",
      "answers": [
        {
          "key": "a",
          "text": "To clear the current statistics snapshot or cache so the next access obtains fresh values",
          "correct": true
        },
        {
          "key": "b",
          "text": "To delete all system catalog tables",
          "correct": false
        },
        {
          "key": "c",
          "text": "To stop statistics collection for the entire cluster",
          "correct": false
        },
        {
          "key": "d",
          "text": "To clear WAL up to the last checkpoint",
          "correct": false
        }
      ],
      "explanation": "pg_stat_clear_snapshot() clears the current statistics snapshot or cached values in a transaction; the next access forms a new snapshot or cache according to stats_fetch_consistency.",
