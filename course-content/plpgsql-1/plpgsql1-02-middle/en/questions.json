    {
      "type": "single_choice",
      "text": "What is the safer way to pass data values to dynamic EXECUTE?",
      "answers": [
        {
          "key": "a",
          "text": "Use $1, $2 parameters with the USING clause",
          "correct": true
        },
        {
          "key": "b",
          "text": "Concatenate arbitrary values without escaping",
          "correct": false
        },
        {
          "key": "c",
          "text": "Use only dollar quoting around unknown values",
          "correct": false
        },
        {
          "key": "d",
          "text": "Use psql :variables",
          "correct": false
        }
      ],
      "explanation": "USING keeps values in their native data types and avoids text quoting for data values.",
