    {
      "type": "single_choice",
      "text": "What does `INTO STRICT` mean?",
      "answers": [
        {
          "key": "a",
          "text": "The command must return exactly one row or an error is raised",
          "correct": true
        },
        {
          "key": "b",
          "text": "The command must return at least two rows",
          "correct": false
        },
        {
          "key": "c",
          "text": "The result is always ignored",
          "correct": false
        },
        {
          "key": "d",
          "text": "The SQL runs at Serializable isolation",
          "correct": false
        }
      ],
      "explanation": "STRICT raises NO_DATA_FOUND for zero rows and TOO_MANY_ROWS for more than one row.",
      "source": {
        "key": "plpgsql1-middle-strict",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — PL/pgSQL",
        "section": "43.5.3. Executing a Command with a Single-Row Result",
        "locator": "INTO STRICT",
        "url": "https://postgrespro.ru/docs/postgresql/16/plpgsql-statements"
