        {
          "key": "c",
          "text": "An array type",
          "correct": false
        },
        {
          "key": "d",
          "text": "A cursor type",
          "correct": false
        }
      ],
      "explanation": "`table%ROWTYPE` declares a row variable with the structure of a table or view row.",
