    {
      "type": "single_choice",
      "text": "What does `%TYPE` provide in a variable declaration?",
      "answers": [
        {
          "key": "a",
          "text": "It copies the data type of the referenced variable or column",
          "correct": true
        },
        {
          "key": "b",
          "text": "It copies the column value",
          "correct": false
        },
        {
          "key": "c",
          "text": "It creates a new domain",
          "correct": false
        },
        {
          "key": "d",
          "text": "It returns the type OID",
          "correct": false
        }
      ],
      "explanation": "`%TYPE` avoids duplicating a type declaration and follows changes to the referenced type.",
