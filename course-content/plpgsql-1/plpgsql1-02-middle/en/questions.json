    {
      "type": "multiple_choice",
      "text": "What happens with SELECT ... INTO without STRICT?",
      "answers": [
        {
          "key": "a",
          "text": "The first result row is assigned",
          "correct": true
        },
        {
          "key": "b",
          "text": "If there are no rows, the target values become NULL",
          "correct": true
        },
        {
          "key": "c",
          "text": "FOUND indicates whether a row was obtained",
          "correct": true
        },
        {
          "key": "d",
          "text": "More than one row always raises TOO_MANY_ROWS",
          "correct": false
        }
      ],
      "explanation": "Without STRICT, only the first row is assigned and any additional rows are discarded; FOUND reports whether a row was obtained.",
      "source": {
        "key": "plpgsql1-middle-into-nonstrict",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — PL/pgSQL",
