    {
      "type": "multiple_choice",
      "text": "Which statements about `%TYPE` and `%ROWTYPE` are true?",
      "answers": [
        {
          "key": "a",
          "text": "%TYPE copies the type of a column or variable",
          "correct": true
        },
        {
          "key": "b",
          "text": "%ROWTYPE supplies the row structure of a table or view",
          "correct": true
        },
        {
          "key": "c",
          "text": "They reduce duplicated type declarations in a function",
          "correct": true
        },
        {
          "key": "d",
          "text": "%ROWTYPE stores only the table name as a string",
          "correct": false
        }
      ],
      "explanation": "Both constructs tie PL/pgSQL declarations to existing database types and reduce type duplication.",
