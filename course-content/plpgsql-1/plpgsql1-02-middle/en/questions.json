    {
      "type": "single_choice",
      "text": "How does RECORD differ from `%ROWTYPE`?",
      "answers": [
        {
          "key": "a",
          "text": "RECORD has no predetermined structure and acquires one when a row is assigned",
          "correct": true
        },
        {
          "key": "b",
          "text": "RECORD always has the row type of pg_class",
          "correct": false
        },
        {
          "key": "c",
          "text": "RECORD cannot change",
          "correct": false
        },
        {
          "key": "d",
          "text": "RECORD is a synonym for integer",
          "correct": false
        }
      ],
      "explanation": "A RECORD variable acquires its structure dynamically; before its first assignment, its fields cannot be accessed.",
      "source": {
        "key": "plpgsql1-middle-record",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — PL/pgSQL",
        "section": "43.3.5. Record Types",
        "locator": "RECORD",
        "url": "https://postgrespro.ru/docs/postgresql/16/plpgsql-declarations"
