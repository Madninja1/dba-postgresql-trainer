        {
          "key": "c",
          "text": "Always use RETURN QUERY",
          "correct": false
        },
        {
          "key": "d",
          "text": "Use VACUUM",
          "correct": false
        }
      ],
      "explanation": "PERFORM executes the query and discards its result.",
