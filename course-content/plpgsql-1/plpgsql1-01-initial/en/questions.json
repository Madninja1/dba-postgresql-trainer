    {
      "type": "single_choice",
      "text": "How do you execute a SELECT whose result is not needed but whose side effects matter?",
      "answers": [
        {
          "key": "a",
          "text": "Use PERFORM",
          "correct": true
        },
        {
          "key": "b",
          "text": "Use DROP RESULT",
          "correct": false
