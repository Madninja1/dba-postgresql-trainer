    {
      "type": "single_choice",
      "text": "What is PL/pgSQL intended for?",
      "answers": [
        {
          "key": "a",
          "text": "Creating server-side functions, procedures, and triggers with control structures on top of SQL",
          "correct": true
        },
        {
          "key": "b",
          "text": "Only for formatting psql output",
          "correct": false
        },
        {
          "key": "c",
          "text": "Only for creating indexes",
          "correct": false
        },
        {
          "key": "d",
          "text": "For managing systemd",
          "correct": false
        }
      ],
      "explanation": "PL/pgSQL is a procedural language that extends SQL with control structures and runs on the server.",
