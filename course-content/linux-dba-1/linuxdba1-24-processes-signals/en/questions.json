    {
      "key": "linuxdba1-processes-signals-008",
      "type": "multiple_choice",
      "text": "What does the `SELECT pg_sleep(300);` example demonstrate? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "A long-running query can be created",
          "correct": true
        },
        {
          "key": "b",
          "text": "Its PID and query text can be found from another session through `pg_stat_activity`",
          "correct": true
        },
        {
          "key": "c",
          "text": "The resulting PID belongs to the backend running that query",
          "correct": true
        },
        {
          "key": "d",
          "text": "`pg_sleep` stops the entire PostgreSQL cluster",
          "correct": false
        }
      ],
      "explanation": "A long `pg_sleep` is used as a target for observation and subsequent cancellation of the current query.",
      "source": {
        "key": "linuxdba1-24-pg-sleep",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "pg_stat_activity",
        "locator": "Lab 24 — finding a long-running query",
        "url": null
      }
    },
    {
      "key": "linuxdba1-processes-signals-009",
      "type": "single_choice",
      "text": "What usually happens to a PostgreSQL backend after `kill -INT PID` during `pg_sleep`, according to the lab?",
      "answers": [
        {
          "key": "a",
          "text": "The current query is interrupted while the backend remains alive",
          "correct": true
        },
        {
          "key": "b",
          "text": "The entire cluster stops immediately",
          "correct": false
        },
        {
          "key": "c",
          "text": "The backend always becomes a zombie",
          "correct": false
        },
        {
          "key": "d",
          "text": "The signal is always ignored",
          "correct": false
        }
      ],
      "explanation": "SIGINT is used in the lab to cancel the current query; afterward, the same connection is checked with `SELECT 1;`.",
      "source": {
        "key": "linuxdba1-24-sigint",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "PostgreSQL backend signals",
        "locator": "Lab 24 — SIGINT",
        "url": null
      }
    },
    {
      "key": "linuxdba1-processes-signals-010",
      "type": "multiple_choice",
      "text": "Which statements about SIGTERM for an individual PostgreSQL backend match the lab? Select all correct answers.",
      "answers": [
