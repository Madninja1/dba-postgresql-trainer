      "key": "linuxdba1-processes-signals-001",
      "type": "single_choice",
      "text": "What does `echo $$` show in the lab?",
      "answers": [
        {
          "key": "a",
          "text": "PID of the current shell",
          "correct": true
        },
        {
          "key": "b",
          "text": "PID of the PostgreSQL postmaster",
          "correct": false
        },
        {
          "key": "c",
          "text": "Number of processes",
          "correct": false
        },
        {
          "key": "d",
          "text": "Exit status of the last command",
          "correct": false
        }
      ],
      "explanation": "`$$` is a special shell parameter containing the PID of the current shell.",
