        {
          "key": "b",
          "text": "pg_terminate_backend(PID)",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_backend_pid()",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_sleep(PID)",
          "correct": false
        }
      ],
      "explanation": "`pg_cancel_backend()` is used to cancel the backend's current work; the lab explicitly contrasts cancel with terminate.",
      "source": {
        "key": "linuxdba1-24-cancel-backend",
