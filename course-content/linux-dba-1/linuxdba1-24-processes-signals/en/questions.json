    {
      "key": "linuxdba1-processes-signals-004",
      "type": "multiple_choice",
      "text": "Which commands from the lab can be used to find PostgreSQL processes in Linux? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "`ps -ef | grep postgres`",
          "correct": true
        },
        {
          "key": "b",
          "text": "`ps aux | grep postgres`",
          "correct": true
        },
        {
          "key": "c",
          "text": "`pgrep -a postgres`",
          "correct": true
        },
        {
          "key": "d",
          "text": "`df -h postgres`",
          "correct": false
        }
      ],
      "explanation": "The material shows variants using `ps | grep` and a cleaner output with `pgrep -a postgres`.",
      "source": {
        "key": "linuxdba1-24-find-processes",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "PostgreSQL processes",
        "locator": "Lab 24 — finding PostgreSQL processes",
        "url": null
      }
    },
    {
      "key": "linuxdba1-processes-signals-005",
      "type": "single_choice",
      "text": "Which SQL function returns the PID of the backend for the current PostgreSQL session?",
      "answers": [
        {
          "key": "a",
          "text": "pg_backend_pid()",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_cancel_backend()",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_terminate_backend()",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_sleep()",
          "correct": false
        }
      ],
      "explanation": "`pg_backend_pid()` returns the PID of the backend process serving the current connection.",
      "source": {
        "key": "linuxdba1-24-backend-pid",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "PostgreSQL backend PID",
        "locator": "Lab 24 — mapping a backend to a Linux PID",
        "url": null
      }
    },
    {
      "key": "linuxdba1-processes-signals-006",
      "type": "multiple_choice",
      "text": "Which actions connect the current PostgreSQL session to a Linux process? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "Run `SELECT pg_backend_pid();`",
          "correct": true
        },
        {
          "key": "b",
          "text": "Pass the resulting PID to `ps -fp PID`",
          "correct": true
        },
        {
          "key": "c",
          "text": "Compare the PID with `pg_stat_activity.pid`",
          "correct": true
        },
        {
          "key": "d",
          "text": "Use `du -sh PID`",
          "correct": false
        }
      ],
      "explanation": "The material builds a direct chain: PostgreSQL session → backend PID → Linux process and recommends comparing the PID with `pg_stat_activity`.",
      "source": {
        "key": "linuxdba1-24-pid-link",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "PostgreSQL backend PID",
        "locator": "Lab 24 — connecting a PostgreSQL session and Linux process",
        "url": null
      }
    },
