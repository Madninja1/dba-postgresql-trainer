    {
      "key": "linuxdba1-processes-signals-016",
      "type": "multiple_choice",
      "text": "What is the difference between `pg_cancel_backend()` and `pg_terminate_backend()` in the lab? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "`pg_cancel_backend()` cancels the backend's current work",
          "correct": true
        },
        {
          "key": "b",
          "text": "`pg_terminate_backend()` terminates the backend/session",
          "correct": true
        },
        {
          "key": "c",
          "text": "Cancel and terminate are different actions",
          "correct": true
        },
        {
          "key": "d",
          "text": "Both functions only display a PID",
          "correct": false
        }
      ],
      "explanation": "The material reinforces the model `cancel ≠ terminate`: the first function cancels current work, while the second terminates the session.",
      "source": {
        "key": "linuxdba1-24-cancel-terminate",
        "kind": "course_material",
