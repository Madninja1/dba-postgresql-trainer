    {
      "key": "linuxdba1-systemd-journal-006",
      "type": "multiple_choice",
      "text": "Which statements about `systemctl is-active` and `systemctl is-enabled` are correct? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "`is-active` answers whether the unit is running now",
          "correct": true
