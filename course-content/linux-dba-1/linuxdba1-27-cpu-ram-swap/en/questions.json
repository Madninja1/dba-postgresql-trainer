    {
      "key": "linuxdba1-cpu-ram-swap-011",
      "type": "single_choice",
      "text": "Why does a small `free` value in Linux not necessarily mean there is a memory shortage?",
      "answers": [
        {
          "key": "a",
          "text": "Linux actively uses RAM for cache, so `available` should also be considered",
          "correct": true
        },
        {
          "key": "b",
          "text": "Because `free` shows only CPU",
          "correct": false
        },
        {
          "key": "c",
          "text": "Because Linux does not use RAM",
          "correct": false
        },
        {
          "key": "d",
          "text": "Because `free` always equals swap",
          "correct": false
        }
      ],
      "explanation": "A large buff/cache value with normal `available` can be a normal state rather than memory pressure.",
      "source": {
        "key": "linuxdba1-27-page-cache",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "RAM",
        "locator": "Lab 27 — page cache and the free field",
        "url": null
      }
    },
