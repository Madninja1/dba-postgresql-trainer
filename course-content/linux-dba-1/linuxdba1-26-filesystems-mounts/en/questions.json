    {
      "key": "linuxdba1-filesystems-mounts-008",
      "type": "multiple_choice",
      "text": "Why can the `/pgdata` directory exist even when the separate disk is not mounted? Select all correct answers.",
      "answers": [
        {
          "key": "a",
          "text": "A mount point is itself an ordinary directory",
          "correct": true
        },
        {
          "key": "b",
          "text": "If the mount did not happen, writes can go to the parent/root filesystem",
          "correct": true
        },
        {
          "key": "c",
          "text": "`ls -ld /pgdata` can still work",
          "correct": true
        },
        {
          "key": "d",
          "text": "The existence of the directory guarantees that the required disk is mounted",
          "correct": false
        }
      ],
      "explanation": "The material emphasizes the risk: the directory continues to exist even if the expected filesystem is not attached.",
      "source": {
        "key": "linuxdba1-26-missing-mount",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "Mounting",
        "locator": "Lab 26 — risk of writing to a mount point without the mount",
        "url": null
      }
    },
    {
      "key": "linuxdba1-filesystems-mounts-009",
      "type": "single_choice",
      "text": "Which sequence of layers matches the lab with a separate disk?",
      "answers": [
        {
          "key": "a",
          "text": "disk → partition → filesystem → mount point",
          "correct": true
        },
        {
          "key": "b",
          "text": "filesystem → PID → partition → user",
          "correct": false
