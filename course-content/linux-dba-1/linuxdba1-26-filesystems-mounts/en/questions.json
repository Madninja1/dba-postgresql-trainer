        {
          "key": "c",
          "text": "mount point → signal → disk → SQL",
          "correct": false
        },
        {
          "key": "d",
          "text": "partition → process → journal → filesystem",
          "correct": false
        }
      ],
      "explanation": "The practice explicitly distinguishes `/dev/sdb` as the disk, `/dev/sdb1` as the partition, ext4 as the filesystem, and `/mnt/pg-lab` as the mount point.",
      "source": {
        "key": "linuxdba1-26-storage-chain",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "Block devices",
        "locator": "Lab 26 — disk/partition/filesystem/mount model",
