    {
      "key": "linuxdba1-filesystems-mounts-003",
      "type": "single_choice",
      "text": "What is the main difference between `df` and `du` according to the lab?",
      "answers": [
        {
          "key": "a",
          "text": "`df` shows filesystem usage, while `du` shows the size of specific files/directories",
          "correct": true
        },
        {
          "key": "b",
          "text": "`df` shows PIDs, while `du` shows UIDs",
          "correct": false
        },
        {
          "key": "c",
          "text": "`df` creates a filesystem, while `du` mounts it",
          "correct": false
        },
        {
          "key": "d",
          "text": "There is no difference",
          "correct": false
        }
      ],
      "explanation": "`df` answers questions about the filesystem as a whole, while `du` reports the size of a file/directory tree.",
