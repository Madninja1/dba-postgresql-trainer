    {
      "key": "linuxdba1-users-groups-permissions-013",
      "type": "single_choice",
      "text": "What does `chown postgres:dbadmins /srv/pgbackup` do?",
      "answers": [
        {
          "key": "a",
          "text": "Sets owner to `postgres` and group to `dbadmins`",
          "correct": true
        },
        {
          "key": "b",
          "text": "Sets mode 770",
          "correct": false
        },
        {
          "key": "c",
          "text": "Adds postgres to group dbadmins",
          "correct": false
        },
        {
          "key": "d",
          "text": "Creates directory /srv/pgbackup",
          "correct": false
        }
      ],
      "explanation": "The `owner:group` syntax lets one command set both the owner and the group of an object.",
      "source": {
        "key": "linuxdba1-25-chown-owner-group",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "Owners and groups",
        "locator": "Lab 25 — owner and group together",
        "url": null
      }
    },
