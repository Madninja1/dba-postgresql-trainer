    {
      "key": "linuxdba1-users-groups-permissions-015",
      "type": "single_choice",
      "text": "Why is `chmod -R 777 /srv/dba-lab` described as a bad habit?",
      "answers": [
        {
          "key": "a",
          "text": "It grants full access to everyone instead of assigning the minimum necessary permissions",
          "correct": true
        },
        {
          "key": "b",
          "text": "It always deletes the directory",
          "correct": false
        },
        {
          "key": "c",
          "text": "It changes the filesystem to ext4",
          "correct": false
        },
        {
          "key": "d",
          "text": "It terminates PostgreSQL processes",
          "correct": false
        }
      ],
      "explanation": "The lab reinforces the principle of least privilege: fix the specific access problem instead of opening everything to everyone.",
