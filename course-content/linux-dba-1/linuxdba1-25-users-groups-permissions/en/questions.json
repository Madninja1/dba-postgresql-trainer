        {
          "key": "a",
          "text": "UID",
          "correct": true
        },
        {
          "key": "b",
          "text": "Primary GID",
          "correct": true
        },
        {
          "key": "c",
          "text": "Supplementary groups",
          "correct": true
        },
        {
          "key": "d",
          "text": "Filesystem UUID",
          "correct": false
        }
      ],
      "explanation": "`id` prints user and group identifiers: UID, GID, and the group list.",
      "source": {
        "key": "linuxdba1-25-id",
