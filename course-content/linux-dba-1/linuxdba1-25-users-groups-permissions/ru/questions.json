    {
      "key": "linuxdba1-users-groups-permissions-005",
      "type": "single_choice",
      "text": "Что устанавливает `chmod 750 /srv/pgbackup`?",
      "answers": [
        {
          "key": "a",
          "text": "owner `rwx`, group `r-x`, others `---`",
          "correct": true
        },
        {
          "key": "b",
          "text": "owner `rw-`, group `r--`, others `---`",
          "correct": false
        },
        {
          "key": "c",
          "text": "всем полный доступ",
          "correct": false
        },
        {
          "key": "d",
          "text": "только owner `r--`",
          "correct": false
        }
      ],
      "explanation": "В octal notation `7 = rwx`, `5 = r-x`, `0 = ---`.",
      "source": {
        "key": "linuxdba1-25-chmod-750",
        "kind": "course_material",
        "module": "Linux DBA",
        "section": "chmod",
        "locator": "Лабораторная №25 — octal permissions",
