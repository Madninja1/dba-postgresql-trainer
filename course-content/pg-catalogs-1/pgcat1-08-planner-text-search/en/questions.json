{
  "schema_version": 1,
  "topic": "pgcat1-planner-text-search",
  "questions": [
    {
      "key": "pgcat1-planner-text-search-001",
      "type": "single_choice",
      "text": "Which catalog contains statistics about database contents created by ANALYZE and used by the planner?",
      "answers": [
        {
          "key": "a",
          "text": "pg_statistic",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_statistic_ext",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_class",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_stats_ext",
          "correct": false
        }
      ],
      "explanation": "pg_statistic stores basic column and expression statistics created by ANALYZE and used by the planner.",
      "source": {
        "key": "pgcat1-pg-statistic-0a2f3c41",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.51. pg_statistic",
        "locator": "Purpose of pg_statistic",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-statistic"
      }
    },
    {
      "key": "pgcat1-planner-text-search-002",
      "type": "multiple_choice",
      "text": "Which pg_statistic fields belong to basic column statistics?",
      "answers": [
        {
          "key": "a",
          "text": "stanullfrac — fraction of NULL values",
          "correct": true
        },
        {
          "key": "b",
          "text": "stawidth — average size of non-NULL values",
          "correct": true
        },
        {
          "key": "c",
          "text": "stadistinct — estimated number of distinct non-NULL values",
          "correct": true
        },
        {
          "key": "d",
          "text": "starelid — table or index",
          "correct": true
        },
        {
          "key": "e",
          "text": "staattnum — column number",
          "correct": true
        },
        {
          "key": "f",
          "text": "stanullfrac stores the exact number of rows containing NULL",
          "correct": false
        }
      ],
      "explanation": "These fields identify the relation/column and store key general statistics.",
      "source": {
        "key": "pgcat1-pg-statistic-a93a8f60",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.51. pg_statistic",
        "locator": "starelid, staattnum, stanullfrac, stawidth, stadistinct",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-statistic"
      }
    },
    {
      "key": "pgcat1-planner-text-search-003",
      "type": "single_choice",
      "text": "Why is pg_statistic not readable by every user?",
      "answers": [
        {
          "key": "a",
          "text": "Even statistics can reveal confidential information about data values",
          "correct": true
        },
        {
          "key": "b",
          "text": "It contains mandatory plain-text passwords for every role",
          "correct": false
        },
        {
          "key": "c",
          "text": "It always blocks tables for writes",
          "correct": false
        },
        {
          "key": "d",
          "text": "It stores postgresql.conf",
          "correct": false
        }
      ],
      "explanation": "The documentation notes that even min/max or other statistics can reveal sensitive data.",
      "source": {
        "key": "pgcat1-pg-statistic-13f6c6e1",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.51. pg_statistic",
        "locator": "Access restriction and the pg_stats view",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-statistic"
      }
    },
    {
      "key": "pgcat1-planner-text-search-004",
      "type": "multiple_choice",
      "text": "What is offered to ordinary users instead of direct access to pg_statistic?",
      "answers": [
        {
          "key": "a",
          "text": "The pg_stats view",
          "correct": true
        },
        {
          "key": "b",
          "text": "It shows information only for tables the user can read",
          "correct": true
        },
        {
          "key": "c",
          "text": "pg_stats is based on pg_statistic",
          "correct": true
        },
        {
          "key": "d",
          "text": "pg_authid",
          "correct": false
        }
      ],
      "explanation": "pg_stats is a safer user-facing view over pg_statistic that filters information according to the current user's privileges.",
      "source": {
        "key": "pgcat1-pg-statistic-06d92697",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.51. pg_statistic",
        "locator": "pg_stats view",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-statistic"
      }
    },
    {
