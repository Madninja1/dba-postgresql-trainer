{
  "schema_version": 1,
  "topic": "pgcat1-logical-replication",
  "questions": [
    {
      "key": "pgcat1-logical-replication-001",
      "type": "single_choice",
      "text": "Which catalog contains logical replication publications created in the current database?",
      "answers": [
        {
          "key": "a",
          "text": "pg_publication",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_subscription",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_publication_rel",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_replication_origin",
          "correct": false
        }
      ],
      "explanation": "pg_publication stores logical replication publications.",
      "source": {
        "key": "pgcat1-pg-publication-c2fb7a63",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.40. pg_publication",
        "locator": "Purpose of pg_publication",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-publication"
      }
    },
    {
      "key": "pgcat1-logical-replication-002",
      "type": "multiple_choice",
      "text": "Which pg_publication flags define which operations are published?",
      "answers": [
        {
          "key": "a",
          "text": "pubinsert",
          "correct": true
        },
        {
          "key": "b",
          "text": "pubupdate",
          "correct": true
        },
        {
          "key": "c",
          "text": "pubdelete",
          "correct": true
        },
        {
          "key": "d",
          "text": "pubtruncate",
          "correct": true
        },
        {
          "key": "e",
          "text": "puballtables",
          "correct": false
        }
      ],
      "explanation": "pubinsert/pubupdate/pubdelete/pubtruncate control DML operation types; puballtables separately means that all tables are automatically included.",
      "source": {
        "key": "pgcat1-pg-publication-856b5247",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.40. pg_publication",
        "locator": "pubinsert, pubupdate, pubdelete, pubtruncate",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-publication"
      }
    },
    {
      "key": "pgcat1-logical-replication-003",
      "type": "single_choice",
      "text": "What does pg_publication.puballtables=true mean?",
      "answers": [
        {
          "key": "a",
          "text": "The publication automatically includes all tables in the database, including tables created in the future",
          "correct": true
        },
        {
          "key": "b",
          "text": "The publication contains only system tables",
          "correct": false
        },
        {
          "key": "c",
          "text": "The subscription is disabled",
          "correct": false
        },
        {
          "key": "d",
          "text": "Replication is performed only for TRUNCATE",
          "correct": false
        }
      ],
      "explanation": "puballtables=true includes all tables in the database, including future tables.",
      "source": {
        "key": "pgcat1-pg-publication-23dc57f7",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.40. pg_publication",
        "locator": "puballtables column",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-publication"
      }
    },
    {
      "key": "pgcat1-logical-replication-004",
      "type": "multiple_choice",
      "text": "What do pg_publication_namespace and pg_publication_rel store?",
      "answers": [
        {
          "key": "a",
          "text": "pg_publication_namespace — many-to-many mapping between schemas and publications",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_publication_rel — many-to-many mapping between relations and publications",
          "correct": true
        },
        {
          "key": "c",
          "text": "prqual can store a publication row-filter condition",
          "correct": true
        },
        {
          "key": "d",
          "text": "prattrs can restrict the published columns",
          "correct": true
        },
        {
          "key": "e",
          "text": "Both catalogs store subscriber passwords",
          "correct": false
        }
      ],
      "explanation": "These catalogs associate publications with schemas and relations; pg_publication_rel also stores row and column filters.",
      "source": {
        "key": "pgcat1-pg-publication-rel-b3f154c2",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.42. pg_publication_rel",
        "locator": "Purpose; prqual; prattrs",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-publication-rel"
      }
    },
    {
      "key": "pgcat1-logical-replication-005",
      "type": "single_choice",
      "text": "Which catalog contains all existing logical replication subscriptions?",
      "answers": [
        {
          "key": "a",
          "text": "pg_subscription",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_publication",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_subscription_rel",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_replication_origin",
          "correct": false
        }
      ],
      "explanation": "pg_subscription stores subscriptions and is a shared catalog.",
      "source": {
        "key": "pgcat1-pg-subscription-73d5b050",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
