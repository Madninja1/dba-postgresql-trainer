      }
    },
    {
      "key": "pgcat1-logical-replication-006",
      "type": "multiple_choice",
      "text": "Which statements about pg_subscription are true?",
      "answers": [
        {
          "key": "a",
          "text": "The catalog is shared by all databases in the cluster",
          "correct": true
        },
        {
          "key": "b",
          "text": "subenabled shows whether the subscription is enabled",
          "correct": true
        },
        {
          "key": "c",
          "text": "subslotname is the replication slot name on the publisher",
          "correct": true
        },
        {
          "key": "d",
          "text": "subpublications is an array of publication names",
          "correct": true
        },
        {
          "key": "e",
          "text": "Ordinary users have full access to subconninfo including its password",
          "correct": false
        }
      ],
      "explanation": "pg_subscription is shared between databases. subconninfo can contain a password, so ordinary users have restricted access to it.",
      "source": {
        "key": "pgcat1-pg-subscription-f3962192",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.54. pg_subscription",
        "locator": "Shared catalog; subenabled; subslotname; subpublications; subconninfo",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-subscription"
      }
    },
    {
      "key": "pgcat1-logical-replication-007",
      "type": "single_choice",
      "text": "Why is access to pg_subscription.subconninfo restricted for ordinary users?",
      "answers": [
        {
          "key": "a",
          "text": "The connection string can contain a password in plain text",
          "correct": true
        },
        {
          "key": "b",
          "text": "The field contains binary WAL",
          "correct": false
        },
        {
          "key": "c",
          "text": "The field is a system PID",
          "correct": false
        },
        {
          "key": "d",
          "text": "The field stores a table OID",
          "correct": false
        }
      ],
      "explanation": "The documentation explicitly warns that subconninfo can contain a plain-text password.",
      "source": {
        "key": "pgcat1-pg-subscription-f6b4131b",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.54. pg_subscription",
        "locator": "Access restriction for subconninfo",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-subscription"
      }
    },
    {
      "key": "pgcat1-logical-replication-008",
      "type": "multiple_choice",
      "text": "What does pg_subscription.substream mean?",
      "answers": [
        {
          "key": "a",
          "text": "`f` — do not stream in-progress transactions",
          "correct": true
        },
        {
          "key": "b",
          "text": "`t` — spill changes from in-progress transactions to disk and apply them after the publisher commit",
          "correct": true
        },
        {
          "key": "c",
          "text": "`p` — apply changes directly with a parallel apply worker when available",
          "correct": true
        },
        {
          "key": "d",
          "text": "`r` — always make the subscription read-only",
          "correct": false
        }
      ],
      "explanation": "substream controls streaming of in-progress transactions with the f/t/p codes.",
      "source": {
        "key": "pgcat1-pg-subscription-e94bf716",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.54. pg_subscription",
        "locator": "substream column",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-subscription"
      }
    },
    {
      "key": "pgcat1-logical-replication-009",
      "type": "single_choice",
      "text": "What does pg_subscription_rel store?",
      "answers": [
        {
          "key": "a",
