    {
      "key": "pgcat1-logical-replication-010",
      "type": "multiple_choice",
      "text": "Which `pg_subscription_rel.srsubstate` values represent subscription table synchronization states?",
      "answers": [
        {
          "key": "a",
          "text": "`i` — initialization",
          "correct": true
        },
        {
          "key": "b",
          "text": "`d` — data copy",
          "correct": true
        },
        {
          "key": "c",
          "text": "`f` — table copy finished",
          "correct": true
        },
        {
          "key": "d",
          "text": "`s` — synchronized",
          "correct": true
        },
        {
          "key": "e",
          "text": "`r` — ready/normal replication",
          "correct": true
        },
        {
          "key": "f",
          "text": "`x` — subscription deleted",
          "correct": false
        }
      ],
      "explanation": "srsubstate encodes the stages of preparing a relation for normal logical replication.",
      "source": {
        "key": "pgcat1-pg-subscription-rel-5dede4e2",
        "kind": "postgresql_docs",
