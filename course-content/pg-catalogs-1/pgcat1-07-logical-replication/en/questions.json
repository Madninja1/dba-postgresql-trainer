        {
          "key": "c",
          "text": "VACUUM history",
          "correct": false
        },
        {
          "key": "d",
          "text": "Index access methods",
          "correct": false
        }
      ],
      "explanation": "pg_subscription_rel is a many-to-many subscription/relation mapping with synchronization state.",
      "source": {
        "key": "pgcat1-pg-subscription-rel-4453af70",
