        },
        {
          "key": "b",
          "text": "pg_database",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_class",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_namespace",
          "correct": false
        }
      ],
      "explanation": "pg_tablespace stores available tablespaces and is shared across the entire cluster.",
      "source": {
        "key": "pgcat1-pg-tablespace-0355a567",
        "kind": "postgresql_docs",
