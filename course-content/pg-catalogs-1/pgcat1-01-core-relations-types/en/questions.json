      }
    },
    {
      "key": "pgcat1-core-relations-types-012",
      "type": "multiple_choice",
      "text": "Which statements about pg_enum and pg_collation are true?",
      "answers": [
        {
          "key": "a",
          "text": "pg_enum.enumlabel stores the text label of an enum value",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_enum.enumsortorder defines the value order within an enum",
          "correct": true
        },
        {
          "key": "c",
          "text": "pg_collation.collprovider can identify libc or ICU",
          "correct": true
        },
        {
          "key": "d",
          "text": "pg_collation.collencoding=-1 means the collation applies to any encoding",
          "correct": true
        },
        {
          "key": "e",
          "text": "pg_enum stores role definitions",
          "correct": false
        }
      ],
      "explanation": "pg_enum describes enum values and their ordering, while pg_collation describes available collations and their provider/encoding.",
      "source": {
        "key": "pgcat1-pg-enum-572db962",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.20. pg_enum",
        "locator": "enumlabel and enumsortorder",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-enum"
      }
    },
    {
      "key": "pgcat1-core-relations-types-013",
      "type": "single_choice",
      "text": "Which catalog stores available tablespaces and is shared by all databases in the cluster?",
