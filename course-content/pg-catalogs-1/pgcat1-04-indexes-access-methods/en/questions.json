{
  "schema_version": 1,
  "topic": "pgcat1-indexes-access-methods",
  "questions": [
    {
      "key": "pgcat1-indexes-access-methods-001",
      "type": "single_choice",
      "text": "What does pg_am describe?",
      "answers": [
        {
          "key": "a",
          "text": "Relation access methods",
          "correct": true
        },
        {
          "key": "b",
          "text": "Autovacuum parameters",
          "correct": false
        },
        {
          "key": "c",
          "text": "Role membership",
          "correct": false
        },
        {
          "key": "d",
          "text": "Subscription states",
          "correct": false
        }
      ],
      "explanation": "pg_am contains one row for each access method supported by the system; in the current description, access methods are defined for tables and indexes.",
      "source": {
        "key": "pgcat1-pg-am-8663c1f8",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.3. pg_am",
        "locator": "Purpose of pg_am",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-am"
      }
    },
    {
      "key": "pgcat1-indexes-access-methods-002",
      "type": "multiple_choice",
      "text": "Which pg_am.amtype values are correct?",
      "answers": [
        {
          "key": "a",
          "text": "`t` — table access method",
          "correct": true
        },
        {
          "key": "b",
          "text": "`i` — index access method",
          "correct": true
        },
        {
          "key": "c",
          "text": "`v` — view access method",
          "correct": false
        },
        {
          "key": "d",
          "text": "`r` — replication method",
          "correct": false
        }
      ],
      "explanation": "amtype distinguishes table (`t`) and index (`i`) access methods.",
      "source": {
        "key": "pgcat1-pg-am-ad455b94",
