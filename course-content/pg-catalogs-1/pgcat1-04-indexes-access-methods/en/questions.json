      }
    },
    {
      "key": "pgcat1-indexes-access-methods-008",
      "type": "multiple_choice",
      "text": "Which pg_index flags describe index state or purpose?",
      "answers": [
        {
          "key": "a",
          "text": "indisunique — unique index",
          "correct": true
        },
        {
          "key": "b",
          "text": "indisprimary — index represents a PRIMARY KEY",
          "correct": true
        },
        {
          "key": "c",
          "text": "indisvalid — index may be used in queries",
          "correct": true
        },
        {
          "key": "d",
          "text": "indisready — index is ready to accept data",
          "correct": true
        },
        {
          "key": "e",
          "text": "indislive=false — index is being dropped",
          "correct": true
        },
        {
          "key": "f",
          "text": "indisready=false means the index can safely be used in queries",
          "correct": false
        }
      ],
      "explanation": "These fields distinguish uniqueness/primary-key status and the readiness, validity, and deletion phases of an index.",
      "source": {
        "key": "pgcat1-pg-index-d3a24ef8",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.26. pg_index",
        "locator": "indisunique, indisprimary, indisvalid, indisready, indislive",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-index"
      }
    },
    {
      "key": "pgcat1-indexes-access-methods-009",
      "type": "single_choice",
      "text": "What does a zero element in pg_index.indkey mean?",
      "answers": [
        {
          "key": "a",
          "text": "The corresponding index attribute is defined by an expression rather than a simple column reference",
          "correct": true
        },
        {
          "key": "b",
          "text": "It always means the first table column",
          "correct": false
        },
        {
          "key": "c",
          "text": "The entire index is invalid",
          "correct": false
        },
        {
          "key": "d",
          "text": "The column has type integer",
          "correct": false
        }
      ],
      "explanation": "In indkey, ordinary numbers correspond to pg_attribute.attnum, while 0 identifies an expression index attribute.",
      "source": {
        "key": "pgcat1-pg-index-0effb7cf",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.26. pg_index",
        "locator": "indkey column",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-index"
      }
    },
