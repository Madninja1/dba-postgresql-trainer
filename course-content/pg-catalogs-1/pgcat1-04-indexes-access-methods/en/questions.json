    {
      "key": "pgcat1-indexes-access-methods-006",
      "type": "multiple_choice",
      "text": "Which statements about pg_opclass and pg_opfamily are true?",
      "answers": [
        {
          "key": "a",
          "text": "pg_opclass associates an indexed data type with an access method and operator family",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_opfamily represents a family of compatible operators and procedures",
          "correct": true
        },
        {
          "key": "c",
          "text": "opcmethod references pg_am",
          "correct": true
        },
        {
          "key": "d",
          "text": "opcfamily references pg_opfamily",
          "correct": true
        },
        {
          "key": "e",
          "text": "pg_opfamily stores only cluster databases",
          "correct": false
        }
      ],
      "explanation": "An operator class defines how a family applies to a type/access method, while an operator family groups compatible operators and support procedures.",
      "source": {
        "key": "pgcat1-pg-opclass-4d390ff5",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.33. pg_opclass",
        "locator": "Purpose of pg_opclass and references opcmethod/opcfamily",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-opclass"
      }
    },
    {
      "key": "pgcat1-indexes-access-methods-007",
      "type": "single_choice",
      "text": "Which catalog stores part of the index information that supplements pg_class?",
      "answers": [
        {
          "key": "a",
          "text": "pg_index",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_am",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_opclass",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_partitioned_table",
          "correct": false
        }
      ],
      "explanation": "pg_index contains index-specific properties, while general relation information is stored in pg_class.",
      "source": {
        "key": "pgcat1-pg-index-2e33066d",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.26. pg_index",
