        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.3. pg_am",
        "locator": "amtype column",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-am"
      }
    },
    {
      "key": "pgcat1-indexes-access-methods-003",
      "type": "single_choice",
      "text": "What does pg_amop describe?",
      "answers": [
        {
          "key": "a",
          "text": "Operators that are members of access-method operator families",
          "correct": true
        },
        {
          "key": "b",
          "text": "Support functions of operator families",
          "correct": false
        },
        {
          "key": "c",
          "text": "Only ordinary SQL functions",
          "correct": false
        },
        {
          "key": "d",
          "text": "Only physical-storage tablespaces",
          "correct": false
        }
      ],
      "explanation": "pg_amop stores operators belonging to access-method families; an operator can be used for search or ordering.",
      "source": {
        "key": "pgcat1-pg-amop-d57ca57c",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.4. pg_amop",
        "locator": "Purpose of pg_amop",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-amop"
      }
    },
    {
      "key": "pgcat1-indexes-access-methods-004",
      "type": "multiple_choice",
      "text": "Which values are valid for `pg_amop.amoppurpose`?",
