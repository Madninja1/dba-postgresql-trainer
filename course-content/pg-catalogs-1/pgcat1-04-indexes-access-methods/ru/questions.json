    {
      "key": "pgcat1-indexes-access-methods-008",
      "type": "multiple_choice",
      "text": "Какие флаги pg_index характеризуют состояние или назначение индекса?",
      "answers": [
        {
          "key": "a",
          "text": "indisunique — уникальный индекс",
          "correct": true
        },
        {
          "key": "b",
          "text": "indisprimary — индекс представляет PRIMARY KEY",
          "correct": true
        },
        {
          "key": "c",
          "text": "indisvalid — индекс можно применять в запросах",
          "correct": true
        },
        {
          "key": "d",
          "text": "indisready — индекс готов к добавлению данных",
          "correct": true
        },
        {
          "key": "e",
          "text": "indislive=false — индекс находится в процессе удаления",
          "correct": true
        },
        {
          "key": "f",
          "text": "indisready=false означает, что индекс можно безопасно применять в запросах",
          "correct": false
        }
      ],
      "explanation": "Эти поля позволяют различать уникальность/primary key и фазы готовности, валидности и удаления индекса.",
      "source": {
