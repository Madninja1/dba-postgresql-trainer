    {
      "key": "pgcat1-roles-security-006",
      "type": "multiple_choice",
      "text": "Which statements about pg_default_acl are true?",
      "answers": [
        {
          "key": "a",
          "text": "It stores initial privileges assigned to newly created objects",
          "correct": true
        },
        {
          "key": "b",
          "text": "defaclrole associates the entry with a role",
          "correct": true
        },
        {
          "key": "c",
          "text": "defaclnamespace can be 0 for a global entry",
          "correct": true
        },
        {
          "key": "d",
          "text": "The current pg_default_acl retroactively changes the ACLs of all previously created objects",
          "correct": false
        }
      ],
      "explanation": "pg_default_acl affects privileges when objects are created. Changing the default ACL does not rewrite ACLs on existing objects.",
      "source": {
        "key": "pgcat1-pg-default-acl-c7b8eda0",
        "kind": "postgresql_docs",
