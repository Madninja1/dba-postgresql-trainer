{
  "schema_version": 1,
  "topic": "pgcat1-roles-security",
  "questions": [
    {
      "key": "pgcat1-roles-security-001",
      "type": "single_choice",
      "text": "Which catalog contains information about authorization identifiers (roles)?",
      "answers": [
        {
          "key": "a",
          "text": "pg_authid",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_auth_members",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_roles",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_policy",
          "correct": false
        }
      ],
      "explanation": "pg_authid stores roles. PostgreSQL implements the concepts of users and groups through roles.",
      "source": {
        "key": "pgcat1-pg-authid-bb291d5a",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.8. pg_authid",
        "locator": "Purpose of the roles catalog",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-authid"
      }
    },
    {
      "key": "pgcat1-roles-security-002",
      "type": "multiple_choice",
      "text": "Why should ordinary users not be given direct access to pg_authid, and what should be used instead?",
      "answers": [
        {
          "key": "a",
          "text": "pg_authid contains the password field",
          "correct": true
        },
        {
          "key": "b",
          "text": "The pg_roles view is intended for general inspection",
          "correct": true
        },
        {
          "key": "c",
          "text": "The password field is masked in pg_roles",
          "correct": true
        },
        {
          "key": "d",
          "text": "pg_largeobject_metadata should be used instead of pg_authid",
          "correct": false
        }
      ],
      "explanation": "pg_authid contains password data, so the documentation points general users to the pg_roles view, where the password is masked.",
      "source": {
        "key": "pgcat1-pg-authid-7653de7a",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.8. pg_authid",
        "locator": "Access restriction and the pg_roles view",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-authid"
      }
    },
    {
      "key": "pgcat1-roles-security-003",
      "type": "single_choice",
      "text": "Which pg_authid flag shows whether a role can connect to the server?",
