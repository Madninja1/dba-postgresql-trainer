    {
      "key": "pgcat1-roles-security-010",
      "type": "multiple_choice",
      "text": "Which pg_policy.polcmd codes correspond to commands?",
      "answers": [
        {
          "key": "a",
          "text": "`r` — SELECT",
          "correct": true
        },
        {
          "key": "b",
          "text": "`a` — INSERT",
          "correct": true
        },
        {
          "key": "c",
          "text": "`w` — UPDATE",
          "correct": true
        },
        {
          "key": "d",
          "text": "`d` — DELETE",
          "correct": true
        },
        {
          "key": "e",
          "text": "`*` — all commands",
          "correct": true
        },
        {
          "key": "f",
          "text": "`p` — PREPARE only",
          "correct": false
        }
      ],
      "explanation": "polcmd encodes the command to which an RLS policy applies: r/a/w/d/*.",
