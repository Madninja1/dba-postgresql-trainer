    {
      "key": "pgcat1-roles-security-012",
      "type": "multiple_choice",
      "text": "How do pg_seclabel and pg_shseclabel differ?",
      "answers": [
        {
          "key": "a",
          "text": "pg_seclabel stores security labels for database objects",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_shseclabel stores security labels for cluster-wide global objects",
          "correct": true
        },
        {
          "key": "c",
          "text": "pg_shseclabel is shared by all databases in the cluster",
          "correct": true
        },
        {
          "key": "d",
          "text": "Both catalogs store column DEFAULT values",
          "correct": false
        }
      ],
      "explanation": "pg_seclabel applies to objects in a specific database, while pg_shseclabel applies to global objects and is a shared catalog.",
      "source": {
        "key": "pgcat1-pg-shseclabel-901b7938",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
