    {
      "key": "pgcat1-roles-security-011",
      "type": "single_choice",
      "text": "What additional condition is required for pg_policy rows to apply to a table?",
      "answers": [
        {
          "key": "a",
          "text": "pg_class.relrowsecurity must be enabled for the table",
          "correct": true
        },
        {
          "key": "b",
          "text": "The table must have relkind=`i`",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_database.datallowconn must be false",
          "correct": false
        },
        {
          "key": "d",
          "text": "A row must exist in pg_sequence",
          "correct": false
        }
      ],
      "explanation": "The documentation notes that policies from pg_policy apply only when the table has pg_class.relrowsecurity enabled.",
      "source": {
        "key": "pgcat1-pg-policy-b48d830f",
        "kind": "postgresql_docs",
