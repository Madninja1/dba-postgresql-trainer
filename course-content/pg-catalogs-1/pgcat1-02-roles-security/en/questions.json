      }
    },
    {
      "key": "pgcat1-roles-security-007",
      "type": "single_choice",
      "text": "What does privtype=`e` mean in pg_init_privs?",
      "answers": [
        {
          "key": "a",
          "text": "The initial privileges were assigned during CREATE EXTENSION",
          "correct": true
        },
        {
          "key": "b",
          "text": "The privileges were assigned by initdb",
          "correct": false
        },
        {
          "key": "c",
          "text": "The privileges belong to PUBLIC",
          "correct": false
        },
        {
          "key": "d",
          "text": "The object has no initial privileges",
          "correct": false
        }
      ],
      "explanation": "In pg_init_privs, `i` means privileges from initdb, while `e` means privileges recorded during CREATE EXTENSION.",
      "source": {
        "key": "pgcat1-pg-init-privs-687363f2",
        "kind": "postgresql_docs",
