      "key": "pgcat1-roles-security-004",
      "type": "multiple_choice",
      "text": "Which statements about pg_auth_members are true?",
      "answers": [
        {
          "key": "a",
          "text": "roleid identifies the role that contains another role",
          "correct": true
        },
        {
          "key": "b",
          "text": "member identifies the role being granted membership",
          "correct": true
        },
        {
          "key": "c",
          "text": "admin_option allows member to grant the membership to other roles",
          "correct": true
        },
        {
          "key": "d",
          "text": "set_option controls whether SET ROLE is allowed",
          "correct": true
        },
        {
          "key": "e",
          "text": "The catalog stores only role passwords",
          "correct": false
        }
      ],
      "explanation": "pg_auth_members describes membership between roles and the related admin/inherit/set options.",
