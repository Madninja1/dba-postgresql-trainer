    {
      "key": "pgcat1-roles-security-008",
      "type": "multiple_choice",
      "text": "Which statements about pg_parameter_acl are true?",
      "answers": [
        {
          "key": "a",
          "text": "The catalog contains configuration parameters for which nonstandard privileges have been assigned",
          "correct": true
        },
        {
          "key": "b",
          "text": "parname is the parameter name",
          "correct": true
        },
        {
          "key": "c",
          "text": "paracl is the parameter ACL",
          "correct": true
        },
        {
          "key": "d",
          "text": "The catalog is shared by all databases in the cluster",
          "correct": true
        },
        {
          "key": "e",
          "text": "It lists every configuration parameter without exception",
          "correct": false
        }
      ],
      "explanation": "pg_parameter_acl contains only parameters for which privileges were granted to one or more roles; parameters with standard privileges are absent.",
      "source": {
        "key": "pgcat1-pg-parameter-acl-56ae9bd5",
        "kind": "postgresql_docs",
