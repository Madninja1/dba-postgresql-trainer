    {
      "key": "pgcat1-roles-security-002",
      "type": "multiple_choice",
      "text": "Почему обычным пользователям не следует давать прямой доступ к pg_authid и что предлагается вместо этого?",
      "answers": [
        {
          "key": "a",
          "text": "pg_authid содержит поле пароля",
          "correct": true
