  "questions": [
    {
      "key": "pgcat1-functions-operators-language-001",
      "type": "single_choice",
      "text": "How are pg_aggregate and pg_proc related for an aggregate function?",
      "answers": [
        {
          "key": "a",
          "text": "A pg_aggregate row supplements the corresponding pg_proc row",
          "correct": true
        },
        {
          "key": "b",
          "text": "Aggregates exist only in pg_aggregate and have no pg_proc row",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_proc stores only triggers",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_aggregate stores tables while pg_proc stores indexes",
          "correct": false
        }
      ],
      "explanation": "For an aggregate, pg_proc stores the general routine properties, while pg_aggregate stores aggregate-specific properties.",
      "source": {
        "key": "pgcat1-pg-aggregate-3d25f932",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.2. pg_aggregate",
        "locator": "Relationship between pg_aggregate and pg_proc rows",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-aggregate"
      }
    },
    {
