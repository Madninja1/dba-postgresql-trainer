        {
          "key": "c",
          "text": "`h` — hypothetical-set",
          "correct": true
        },
        {
          "key": "d",
          "text": "`w` — window-only",
          "correct": false
        }
      ],
      "explanation": "aggkind distinguishes normal, ordered-set, and hypothetical-set aggregates.",
