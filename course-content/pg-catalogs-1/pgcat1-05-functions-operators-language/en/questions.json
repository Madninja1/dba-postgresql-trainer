        {
          "key": "c",
          "text": "`u` — unsafe for parallel mode",
          "correct": true
        },
        {
          "key": "d",
          "text": "`i` — immutable parallel mode",
          "correct": false
        }
      ],
      "explanation": "proparallel distinguishes safe, restricted, and unsafe execution in parallel mode.",
