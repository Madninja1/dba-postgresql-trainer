    },
    {
      "key": "pgcat1-extensions-fdw-largeobjects-002",
      "type": "multiple_choice",
      "text": "Which statements about `pg_extension` fields are true?",
      "answers": [
        {
          "key": "a",
          "text": "extname — extension name",
          "correct": true
        },
        {
          "key": "b",
          "text": "extowner — owner",
          "correct": true
        },
        {
          "key": "c",
          "text": "extnamespace — schema containing all or most exported objects",
          "correct": true
        },
        {
          "key": "d",
          "text": "extrelocatable — whether the extension can be moved",
          "correct": true
        },
        {
          "key": "e",
          "text": "extversion — version",
          "correct": true
        },
        {
          "key": "f",
          "text": "extnamespace means the extension name is always schema-qualified",
          "correct": false
        }
      ],
      "explanation": "pg_extension stores the name, owner, namespace, relocatability, version, and configuration-related fields.",
      "source": {
        "key": "pgcat1-pg-extension-e3e5acda",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.22. pg_extension",
        "locator": "extname, extowner, extnamespace, extrelocatable, extversion",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-extension"
      }
    },
    {
      "key": "pgcat1-extensions-fdw-largeobjects-003",
      "type": "single_choice",
      "text": "What is important to understand about pg_extension.extnamespace?",
      "answers": [
        {
          "key": "a",
          "text": "It does not mean the extension itself belongs to a schema; extension names are not schema-qualified",
          "correct": true
        },
        {
          "key": "b",
          "text": "It is always equal to the database OID",
          "correct": false
        },
        {
          "key": "c",
          "text": "It contains the extension password",
          "correct": false
        },
        {
          "key": "d",
          "text": "It is a partition key",
          "correct": false
        }
      ],
      "explanation": "The documentation specifically notes that extnamespace identifies where most or all schema-bound objects live, but the extension name itself is not schema-qualified.",
      "source": {
        "key": "pgcat1-pg-extension-dc557288",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.22. pg_extension",
        "locator": "Note about extnamespace",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-extension"
      }
    },
    {
      "key": "pgcat1-extensions-fdw-largeobjects-004",
      "type": "multiple_choice",
      "text": "How is the Foreign Data Wrapper chain represented across catalogs?",
      "answers": [
        {
          "key": "a",
          "text": "pg_foreign_data_wrapper describes the FDW mechanism",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_foreign_server describes an external server and references the FDW",
          "correct": true
        },
        {
          "key": "c",
          "text": "pg_foreign_table supplements the foreign-table row in pg_class",
          "correct": true
        },
        {
          "key": "d",
          "text": "pg_user_mapping associates a local role with a foreign server",
          "correct": true
        },
        {
          "key": "e",
          "text": "pg_index stores FDW passwords",
          "correct": false
        }
      ],
      "explanation": "FDW objects are distributed across the wrapper → server → foreign table/user mapping catalogs.",
      "source": {
