  "questions": [
    {
      "key": "pgcat1-extensions-fdw-largeobjects-001",
      "type": "single_choice",
      "text": "Which catalog stores information about installed extensions?",
      "answers": [
        {
          "key": "a",
          "text": "pg_extension",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_foreign_data_wrapper",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_proc",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_event_trigger",
          "correct": false
        }
      ],
      "explanation": "pg_extension contains installed extensions and their properties.",
      "source": {
        "key": "pgcat1-pg-extension-2b2a76f0",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.22. pg_extension",
