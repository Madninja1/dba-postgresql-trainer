{
  "schema_version": 1,
  "topic": "pgcat1-constraints-dependencies",
  "questions": [
    {
      "key": "pgcat1-constraints-dependencies-001",
      "type": "single_choice",
      "text": "Где PostgreSQL хранит CHECK, UNIQUE, PRIMARY KEY, FOREIGN KEY и EXCLUDE constraints?",
      "answers": [
        {
          "key": "a",
          "text": "pg_constraint",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_attribute",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_depend",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_trigger",
          "correct": false
        }
      ],
      "explanation": "pg_constraint содержит основные табличные и доменные ограничения, включая CHECK, UNIQUE, PRIMARY KEY, FOREIGN KEY и EXCLUDE.",
      "source": {
        "key": "pgcat1-pg-constraint-3f971b66",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Глава 53. Системные каталоги",
        "section": "53.13. pg_constraint",
        "locator": "Назначение каталога",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-002",
      "type": "multiple_choice",
      "text": "Какие соответствия pg_constraint.contype верны?",
      "answers": [
        {
          "key": "a",
          "text": "`c` — CHECK",
          "correct": true
        },
        {
          "key": "b",
          "text": "`f` — FOREIGN KEY",
          "correct": true
        },
        {
          "key": "c",
          "text": "`p` — PRIMARY KEY",
          "correct": true
        },
        {
          "key": "d",
          "text": "`u` — UNIQUE",
          "correct": true
        },
        {
          "key": "e",
          "text": "`x` — EXCLUDE",
          "correct": true
        },
        {
          "key": "f",
          "text": "`n` — NOT NULL",
          "correct": false
        }
      ],
      "explanation": "NOT NULL не представлен как contype в pg_constraint: это свойство хранится в pg_attribute.attnotnull.",
      "source": {
        "key": "pgcat1-pg-constraint-5fa69194",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Глава 53. Системные каталоги",
        "section": "53.13. pg_constraint",
        "locator": "Столбец contype; примечание о NOT NULL",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-003",
      "type": "single_choice",
      "text": "Где хранится ограничение NOT NULL для столбца?",
      "answers": [
        {
          "key": "a",
          "text": "В pg_attribute.attnotnull",
          "correct": true
        },
        {
          "key": "b",
          "text": "В pg_constraint с contype=`n`",
          "correct": false
        },
        {
          "key": "c",
          "text": "В pg_index.indisprimary",
          "correct": false
        },
        {
          "key": "d",
          "text": "В pg_type.typnotnull для всех табличных столбцов",
          "correct": false
        }
      ],
      "explanation": "Документация pg_constraint прямо отмечает, что ограничения NULL представлены не здесь, а в pg_attribute.",
      "source": {
        "key": "pgcat1-pg-constraint-d66f8c58",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Глава 53. Системные каталоги",
        "section": "53.13. pg_constraint",
        "locator": "NOT NULL хранится в pg_attribute",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-004",
      "type": "multiple_choice",
      "text": "Какие поля pg_constraint используются для внешнего ключа?",
