    {
      "key": "pgcat1-constraints-dependencies-005",
      "type": "single_choice",
      "text": "Какой каталог записывает зависимости между объектами внутри базы данных?",
      "answers": [
        {
          "key": "a",
          "text": "pg_depend",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_shdepend",
          "correct": false
