{
  "schema_version": 1,
  "topic": "pgcat1-constraints-dependencies",
  "questions": [
    {
      "key": "pgcat1-constraints-dependencies-001",
      "type": "single_choice",
      "text": "Where does PostgreSQL store CHECK, UNIQUE, PRIMARY KEY, FOREIGN KEY, and EXCLUDE constraints?",
      "answers": [
        {
          "key": "a",
          "text": "pg_constraint",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_attribute",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_depend",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_trigger",
          "correct": false
        }
      ],
      "explanation": "pg_constraint contains the main table and domain constraints, including CHECK, UNIQUE, PRIMARY KEY, FOREIGN KEY, and EXCLUDE.",
      "source": {
        "key": "pgcat1-pg-constraint-3f971b66",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.13. pg_constraint",
        "locator": "Catalog purpose",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-002",
      "type": "multiple_choice",
      "text": "Which pg_constraint.contype mappings are correct?",
      "answers": [
        {
          "key": "a",
          "text": "`c` — CHECK",
          "correct": true
        },
        {
          "key": "b",
          "text": "`f` — FOREIGN KEY",
          "correct": true
        },
        {
          "key": "c",
          "text": "`p` — PRIMARY KEY",
          "correct": true
        },
        {
          "key": "d",
          "text": "`u` — UNIQUE",
          "correct": true
        },
        {
          "key": "e",
          "text": "`x` — EXCLUDE",
          "correct": true
        },
        {
          "key": "f",
          "text": "`n` — NOT NULL",
          "correct": false
        }
      ],
      "explanation": "NOT NULL is not represented as a contype in pg_constraint; it is stored in pg_attribute.attnotnull.",
      "source": {
        "key": "pgcat1-pg-constraint-5fa69194",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.13. pg_constraint",
        "locator": "contype column; note about NOT NULL",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-003",
      "type": "single_choice",
      "text": "Where is a column NOT NULL constraint stored?",
      "answers": [
        {
          "key": "a",
          "text": "In pg_attribute.attnotnull",
          "correct": true
        },
        {
          "key": "b",
          "text": "In pg_constraint with contype=`n`",
          "correct": false
        },
        {
          "key": "c",
          "text": "In pg_index.indisprimary",
          "correct": false
        },
        {
          "key": "d",
          "text": "In pg_type.typnotnull for all table columns",
          "correct": false
        }
      ],
      "explanation": "The pg_constraint documentation explicitly notes that NULL constraints are represented elsewhere, in pg_attribute.",
      "source": {
        "key": "pgcat1-pg-constraint-d66f8c58",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.13. pg_constraint",
        "locator": "NOT NULL is stored in pg_attribute",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-004",
      "type": "multiple_choice",
      "text": "Which pg_constraint fields are used for a foreign key?",
      "answers": [
        {
          "key": "a",
          "text": "conrelid — table containing the constraint",
          "correct": true
        },
        {
          "key": "b",
          "text": "confrelid — table referenced by the FK",
          "correct": true
        },
        {
          "key": "c",
          "text": "conkey — columns of the constraint",
          "correct": true
        },
        {
          "key": "d",
          "text": "confkey — columns referenced by the FK",
          "correct": true
        },
        {
          "key": "e",
          "text": "prosrc — body of the FK function",
          "correct": false
        }
      ],
      "explanation": "For a foreign key, pg_constraint stores both sides of the relationship and the numbers of the corresponding columns.",
      "source": {
        "key": "pgcat1-pg-constraint-72c97552",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.13. pg_constraint",
        "locator": "conrelid, confrelid, conkey, confkey",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-constraint"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-005",
      "type": "single_choice",
      "text": "Which catalog records dependencies between objects inside a database?",
      "answers": [
        {
          "key": "a",
          "text": "pg_depend",
          "correct": true
        },
        {
          "key": "b",
          "text": "pg_shdepend",
          "correct": false
        },
        {
          "key": "c",
          "text": "pg_description",
          "correct": false
        },
        {
          "key": "d",
          "text": "pg_rewrite",
          "correct": false
        }
      ],
      "explanation": "pg_depend stores dependencies between database objects and lets DROP determine what to remove with CASCADE and when to reject removal under RESTRICT.",
      "source": {
        "key": "pgcat1-pg-depend-7bf9dd0f",
        "kind": "postgresql_docs",
        "module": "PostgreSQL 16 — Chapter 53. System Catalogs",
        "section": "53.18. pg_depend",
        "locator": "Purpose of the dependency catalog",
        "url": "https://postgrespro.ru/docs/postgresql/16/catalog-pg-depend"
      }
    },
    {
      "key": "pgcat1-constraints-dependencies-006",
      "type": "multiple_choice",
      "text": "Which `pg_depend.deptype` values are valid dependency types?",
      "answers": [
        {
          "key": "a",
          "text": "`n` — NORMAL",
          "correct": true
        },
        {
          "key": "b",
          "text": "`a` — AUTO",
          "correct": true
        },
        {
          "key": "c",
          "text": "`i` — INTERNAL",
          "correct": true
        },
        {
          "key": "d",
          "text": "`e` — EXTENSION",
          "correct": true
        },
        {
          "key": "e",
          "text": "`x` — AUTO_EXTENSION",
          "correct": true
        },
        {
          "key": "f",
          "text": "`z` — ZOMBIE",
          "correct": false
        }
      ],
      "explanation": "`pg_depend.deptype` uses NORMAL, AUTO, INTERNAL, PARTITION_PRI/SEC, EXTENSION, and AUTO_EXTENSION; `z` is not used.",
      "source": {
